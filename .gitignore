# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
.venv
ENV/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Executables / large binaries (use Release or Git LFS instead)
*.exe
*.dll
*.zip
!vendor/**/7ZIP-ZS-LICENSE.txt
# 放行 ZipForge 运行时必需的 7-Zip-ZS 引擎二进制（7z.dll / 7z.exe）
!vendor/**/engine-x64/7z.dll
!vendor/**/engine-x64/7z.exe

# Local secrets
.env
*.local
secrets.*
